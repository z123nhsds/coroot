+func TestRCASummaryCorrelatesWithSLOAlert(t *testing.T) {
+	t.Run("incident_details_include_rca_summary_when_slo_violation", func(t *testing.T) {
+		app := model.NewApplication(model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "api-gateway"))
+		incident := &model.ApplicationIncident{
+			ApplicationId: app.Id,
+			Key:           "abc12345",
+			OpenedAt:      timeseries.Now(),
+			Severity:      model.CRITICAL,
+			Details: model.IncidentDetails{
+				AvailabilityBurnRates: []model.BurnRate{
+					{
+						LongWindowBurnRate:  14.5,
+						ShortWindowBurnRate: 15.2,
+						Threshold:           14.4,
+						Severity:            model.CRITICAL,
+						LongWindow:          timeseries.Hour,
+						ShortWindow:         5 * timeseries.Minute,
+					},
+				},
+			},
+			RCA: &model.RCA{
+				Status:         "OK",
+				ShortSummary:   "Database connection pool exhaustion causing request failures",
+				RootCause:      "PostgreSQL max_connections reached",
+				ImmediateFixes: "Increase max_connections or add connection pooling",
+			},
+		}
+
+		details := incidentDetails(app, incident)
+
+		assert.NotNil(t, details, "incidentDetails should return non-nil when RCA is present")
+		assert.Equal(t, "Database connection pool exhaustion causing request failures", details.RCASummary,
+			"RCA ShortSummary must propagate to notification details")
+		assert.Equal(t, "Increase max_connections or add connection pooling", details.RCARemediations,
+			"RCA ImmediateFixes must propagate to notification details")
+	})
+
+	t.Run("incident_details_nil_when_no_rca_and_no_reports", func(t *testing.T) {
+		app := model.NewApplication(model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "svc"))
+		incident := &model.ApplicationIncident{
+			ApplicationId: app.Id,
+			Key:           "xyz",
+			OpenedAt:      timeseries.Now(),
+			Severity:      model.WARNING,
+			Details:       model.IncidentDetails{},
+		}
+
+		details := incidentDetails(app, incident)
+		assert.Nil(t, details, "incidentDetails should be nil when no RCA and no failing reports")
+	})
+
+	t.Run("incident_details_excludes_slo_report_checks", func(t *testing.T) {
+		app := model.NewApplication(model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "svc"))
+		report := &model.AuditReport{Name: model.AuditReportSLO}
+		report.Checks = append(report.Checks, &model.Check{
+			Id:      model.Checks.SLOAvailability.Id,
+			Title:   model.Checks.SLOAvailability.Title,
+			Status:  model.CRITICAL,
+			Message: "the app is serving errors",
+		})
+		app.Reports = append(app.Reports, report)
+
+		incident := &model.ApplicationIncident{
+			ApplicationId: app.Id,
+			Key:           "slo-incident",
+			OpenedAt:      timeseries.Now(),
+			Severity:      model.CRITICAL,
+			Details:       model.IncidentDetails{},
+		}
+
+		details := incidentDetails(app, incident)
+		assert.Nil(t, details,
+			"SLO report checks are excluded; with no other failing reports and no RCA, details should be nil")
+	})
+
+	t.Run("incident_details_includes_non_slo_failing_checks_with_rca", func(t *testing.T) {
+		app := model.NewApplication(model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "svc"))
+
+		sloReport := &model.AuditReport{Name: model.AuditReportSLO}
+		sloReport.Checks = append(sloReport.Checks, &model.Check{
+			Id:     model.Checks.SLOAvailability.Id,
+			Title:  model.Checks.SLOAvailability.Title,
+			Status: model.CRITICAL,
+		})
+		app.Reports = append(app.Reports, sloReport)
+
+		memReport := &model.AuditReport{Name: model.AuditReportMemory}
+		memReport.Checks = append(memReport.Checks, &model.Check{
+			Id:      model.Checks.MemoryOOM.Id,
+			Title:   model.Checks.MemoryOOM.Title,
+			Status:  model.WARNING,
+			Message: "3 OOM kills detected",
+		})
+		app.Reports = append(app.Reports, memReport)
+
+		incident := &model.ApplicationIncident{
+			ApplicationId: app.Id,
+			Key:           "mixed-incident",
+			OpenedAt:      timeseries.Now(),
+			Severity:      model.CRITICAL,
+			Details:       model.IncidentDetails{},
+			RCA: &model.RCA{
+				Status:         "OK",
+				ShortSummary:   "Memory pressure causing cascading failures",
+				ImmediateFixes: "Increase memory limits",
+			},
+		}
+
+		details := incidentDetails(app, incident)
+		assert.NotNil(t, details)
+		assert.Equal(t, "Memory pressure causing cascading failures", details.RCASummary)
+
+		var hasSLOCheck, hasOOMCheck bool
+		for _, r := range details.Reports {
+			if r.Name == model.AuditReportSLO {
+				hasSLOCheck = true
+			}
+			if r.Name == model.AuditReportMemory && r.Check == model.Checks.MemoryOOM.Title {
+				hasOOMCheck = true
+			}
+		}
+		assert.False(t, hasSLOCheck, "SLO report checks must be excluded from incident notification details")
+		assert.True(t, hasOOMCheck, "Non-SLO failing checks must be included in incident notification details")
+	})
+
+	t.Run("alert_notification_details_serializes_slo_check_fields", func(t *testing.T) {
+		details := &db.AlertNotificationDetails{
+			ProjectName: "production",
+			RuleName:    "SLO Availability",
+			Severity:    model.CRITICAL.String(),
+			Summary:     "SLOAvailability: the app is serving errors",
+			Details: []model.AlertDetail{
+				{Name: "Description", Value: "Error budget burn rate is 14.5x within 1 hour"},
+			},
+		}
+
+		data, err := json.Marshal(details)
+		assert.NoError(t, err, "AlertNotificationDetails must serialize without error")
+
+		var decoded db.AlertNotificationDetails
+		err = json.Unmarshal(data, &decoded)
+		assert.NoError(t, err, "AlertNotificationDetails must deserialize without error")
+		assert.Equal(t, "SLO Availability", decoded.RuleName)
+		assert.Equal(t, "critical", decoded.Severity)
+		assert.Equal(t, "SLOAvailability: the app is serving errors", decoded.Summary)
+		assert.Len(t, decoded.Details, 1, "SLO alert details should contain Description")
+		assert.Equal(t, "Description", decoded.Details[0].Name)
+	})
+
+	t.Run("slo_burn_rate_format_matches_notification_message", func(t *testing.T) {
+		br := model.BurnRate{
+			LongWindowBurnRate:  14.5,
+			ShortWindowBurnRate: 15.2,
+			Threshold:           14.4,
+			Severity:            model.CRITICAL,
+			LongWindow:          timeseries.Hour,
+			ShortWindow:         5 * timeseries.Minute,
+		}
+
+		statusMsg := br.FormatSLOStatus()
+		assert.Contains(t, statusMsg, "14.5",
+			"BurnRate.FormatSLOStatus must include the burn rate value")
+		assert.Contains(t, statusMsg, "hour",
+			"BurnRate.FormatSLOStatus must include the window unit")
+	})
+
+	t.Run("incident_notification_details_json_roundtrip_preserves_rca", func(t *testing.T) {
+		original := &db.IncidentNotificationDetails{
+			Reports: []db.IncidentNotificationDetailsReport{
+				{Name: model.AuditReportMemory, Check: "Out of memory kills", Message: "3 OOM kills"},
+			},
+			RCASummary:      "Connection pool exhaustion",
+			RCARemediations: "Increase max_connections",
+		}
+
+		data, err := json.Marshal(original)
+		assert.NoError(t, err)
+
+		var decoded db.IncidentNotificationDetails
+		err = json.Unmarshal(data, &decoded)
+		assert.NoError(t, err)
+		assert.Equal(t, original.RCASummary, decoded.RCASummary)
+		assert.Equal(t, original.RCARemediations, decoded.RCARemediations)
+		assert.Len(t, decoded.Reports, 1)
+		assert.Equal(t, model.AuditReportMemory, decoded.Reports[0].Name)
+	})
+
+	t.Run("rca_short_description_prefers_rca_summary", func(t *testing.T) {
+		incident := &model.ApplicationIncident{
+			Severity: model.CRITICAL,
+			Details: model.IncidentDetails{
+				AvailabilityImpact: model.Impact{AffectedRequestPercentage: 5.0},
+				LatencyImpact:      model.Impact{AffectedRequestPercentage: 3.0},
+			},
+			RCA: &model.RCA{
+				Status:       "OK",
+				ShortSummary: "Custom RCA summary",
+			},
+		}
+
+		desc := incident.ShortDescription()
+		assert.Equal(t, "Custom RCA summary", desc,
+			"ShortDescription should prefer RCA.ShortSummary over impact-based description")
+	})
+
+	t.Run("rca_short_description_fallback_to_impact", func(t *testing.T) {
+		incident := &model.ApplicationIncident{
+			Severity: model.CRITICAL,
+			Details: model.IncidentDetails{
+				AvailabilityImpact: model.Impact{AffectedRequestPercentage: 5.0},
+				LatencyImpact:      model.Impact{AffectedRequestPercentage: 3.0},
+			},
+		}
+
+		desc := incident.ShortDescription()
+		assert.Equal(t, "High latency and errors", desc,
+			"ShortDescription should fall back to impact-based description when no RCA")
+	})
+}
