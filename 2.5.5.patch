+func TestUtilsGlobMatchDoesNotBreakWatchersPromHealthCheck(t *testing.T) {
+	t.Run("glob_match_used_by_alerting_rule_matches", func(t *testing.T) {
+		rule := &model.AlertingRule{
+			Selector: model.AppSelector{
+				Type:                  model.AppSelectorTypeApplications,
+				ApplicationIdPatterns: []string{"default:Deployment:*"},
+			},
+		}
+
+		matchingApp := model.NewApplication(model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "web"))
+		assert.True(t, rule.Matches(matchingApp),
+			"AlertingRule.Matches should match app when GlobMatch pattern matches")
+
+		nonMatchingApp := model.NewApplication(model.NewApplicationId("c1", "kube-system", model.ApplicationKindDeployment, "coredns"))
+		assert.False(t, rule.Matches(nonMatchingApp),
+			"AlertingRule.Matches should not match app when GlobMatch pattern doesn't match")
+	})
+
+	t.Run("glob_match_wildcard_all_matches_every_app", func(t *testing.T) {
+		rule := &model.AlertingRule{
+			Selector: model.AppSelector{
+				Type: model.AppSelectorTypeAll,
+			},
+		}
+
+		app1 := model.NewApplication(model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "web"))
+		app2 := model.NewApplication(model.NewApplicationId("c1", "kube-system", model.ApplicationKindStatefulSet, "postgres"))
+		assert.True(t, rule.Matches(app1))
+		assert.True(t, rule.Matches(app2))
+	})
+
+	t.Run("glob_match_category_selector", func(t *testing.T) {
+		rule := &model.AlertingRule{
+			Selector: model.AppSelector{
+				Type:       model.AppSelectorTypeCategory,
+				Categories: []string{"application"},
+			},
+		}
+
+		app := model.NewApplication(model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "web"))
+		app.Category = model.ApplicationCategoryApplication
+		assert.True(t, rule.Matches(app))
+
+		infraApp := model.NewApplication(model.NewApplicationId("c1", "kube-system", model.ApplicationKindDeployment, "coredns"))
+		infraApp.Category = model.ApplicationCategoryControlPlane
+		assert.False(t, rule.Matches(infraApp))
+	})
+
+	t.Run("glob_validate_rejects_invalid_patterns", func(t *testing.T) {
+		assert.True(t, utils.GlobValidate([]string{"default:Deployment:*"}),
+			"Valid glob pattern should pass validation")
+		assert.True(t, utils.GlobValidate([]string{"*"}),
+			"Wildcard pattern should pass validation")
+		assert.False(t, utils.GlobValidate([]string{"[invalid"}),
+			"Invalid glob pattern should fail validation")
+	})
+
+	t.Run("glob_match_edge_cases_for_application_ids", func(t *testing.T) {
+		assert.True(t, utils.GlobMatch("default:Deployment:web", "default:Deployment:*"),
+			"Trailing wildcard should match")
+		assert.True(t, utils.GlobMatch("default:Deployment:web", "*"),
+			"Global wildcard should match any string")
+		assert.False(t, utils.GlobMatch("default:Deployment:web", "kube-system:Deployment:*"),
+			"Different namespace should not match")
+		assert.True(t, utils.GlobMatch("default:Deployment:web", "default:Deployment:web"),
+			"Exact match should work")
+		assert.False(t, utils.GlobMatch("default:Deployment:web", "default:Deployment:api"),
+			"Different name should not match")
+	})
+
+	t.Run("glob_match_matches_alerts_using_string_without_cluster_id", func(t *testing.T) {
+		rule := &model.AlertingRule{
+			Selector: model.AppSelector{
+				Type:                  model.AppSelectorTypeApplications,
+				ApplicationIdPatterns: []string{"default:Deployment:api-*"},
+			},
+		}
+
+		alert := &model.Alert{
+			ApplicationId:       model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "api-gateway"),
+			ApplicationCategory: model.ApplicationCategoryApplication,
+		}
+		assert.True(t, rule.MatchesAlert(alert),
+			"MatchesAlert should use StringWithoutClusterId for glob matching")
+
+		alert2 := &model.Alert{
+			ApplicationId:       model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "web-frontend"),
+			ApplicationCategory: model.ApplicationCategoryApplication,
+		}
+		assert.False(t, rule.MatchesAlert(alert2),
+			"MatchesAlert should not match non-matching application name")
+	})
+
+	t.Run("prom_client_creation_from_config", func(t *testing.T) {
+		promConfig := &db.IntegrationPrometheus{
+			Url:             "http://prometheus:9090",
+			RefreshInterval: timeseries.Minute * 30,
+		}
+
+		client, err := prom.NewClient(promConfig, nil)
+		assert.NoError(t, err, "Creating prom client from valid config should not error")
+		assert.NotNil(t, client, "Client should not be nil")
+		client.Close()
+	})
+
+	t.Run("prom_client_nil_config_returns_error", func(t *testing.T) {
+		client, err := prom.NewClient(nil, nil)
+		assert.Error(t, err, "Creating prom client from nil config should return error")
+		assert.Nil(t, client, "Client should be nil on error")
+	})
+
+	t.Run("prom_client_empty_url_returns_error", func(t *testing.T) {
+		promConfig := &db.IntegrationPrometheus{
+			Url:             "",
+			RefreshInterval: timeseries.Minute * 30,
+		}
+		client, err := prom.NewClient(promConfig, nil)
+		assert.Error(t, err, "Creating prom client with empty URL should return error")
+		assert.Nil(t, client)
+	})
+
+	t.Run("alerting_rule_matches_propagates_to_alert_matching", func(t *testing.T) {
+		rule := &model.AlertingRule{
+			Id:        "slo-availability-rule",
+			Name:      "SLO Availability",
+			Source:     model.AlertSource{Type: model.AlertSourceTypeCheck, Check: &model.CheckSource{CheckId: model.Checks.SLOAvailability.Id}},
+			Selector:  model.AppSelector{Type: model.AppSelectorTypeApplications, ApplicationIdPatterns: []string{"default:Deployment:api-*"}},
+			Severity:  model.CRITICAL,
+			Enabled:   true,
+			Templates: model.AlertTemplates{Description: "SLO violation detected"},
+		}
+
+		apiApp := model.NewApplication(model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "api-gateway"))
+		assert.True(t, rule.Matches(apiApp),
+			"Rule with pattern 'default:Deployment:api-*' should match 'api-gateway'")
+
+		webApp := model.NewApplication(model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "web-frontend"))
+		assert.False(t, rule.Matches(webApp),
+			"Rule with pattern 'default:Deployment:api-*' should NOT match 'web-frontend'")
+	})
+
+	t.Run("filter_alert_details_removes_promql_fields", func(t *testing.T) {
+		details := []model.AlertDetail{
+			{Name: "Description", Value: "SLO violation"},
+			{Name: "PromQL", Value: "rate(http_requests_total[5m])"},
+			{Name: "PromQLChart", Value: "rate(http_requests_total{job=\"api\"}[5m])"},
+			{Name: "Labels", Value: "job=api"},
+		}
+
+		filtered := filterAlertDetails(details)
+		assert.Len(t, filtered, 2, "Should filter out PromQL and PromQLChart details")
+		assert.Equal(t, "Description", filtered[0].Name)
+		assert.Equal(t, "Labels", filtered[1].Name)
+	})
+
+	t.Run("glob_match_multiple_patterns_any_match", func(t *testing.T) {
+		assert.True(t, utils.GlobMatch("default:Deployment:web", "kube-system:*", "default:Deployment:*"),
+			"GlobMatch should return true if any pattern matches")
+		assert.False(t, utils.GlobMatch("default:Deployment:web", "kube-system:*", "monitoring:*"),
+			"GlobMatch should return false if no pattern matches")
+	})
+}
