+func TestMCPServerLogClusteringWithMemoryGrowthPct(t *testing.T) {
+	t.Run("memory_growth_pct_calculation_stability", func(t *testing.T) {
+		rssData := make([]float32, 120)
+		for i := range rssData {
+			rssData[i] = float32(100*1024*1024 + i*1024*1024)
+		}
+		rss := timeseries.NewWithData(0, 30, rssData)
+		limit := float32(512 * 1024 * 1024)
+		to := timeseries.Time(119 * 30)
+
+		pct := auditor.MemoryGrowthPct(rss, limit, to)
+		assert.Greater(t, pct, float32(0),
+			"MemoryGrowthPct should detect growth for steadily increasing RSS")
+	})
+
+	t.Run("memory_growth_pct_no_growth_returns_zero", func(t *testing.T) {
+		rssData := make([]float32, 120)
+		for i := range rssData {
+			rssData[i] = float32(100 * 1024 * 1024)
+		}
+		rss := timeseries.NewWithData(0, 30, rssData)
+		limit := float32(512 * 1024 * 1024)
+		to := timeseries.Time(119 * 30)
+
+		pct := auditor.MemoryGrowthPct(rss, limit, to)
+		assert.Equal(t, float32(0), pct,
+			"MemoryGrowthPct should return 0 for stable RSS (beta<=0)")
+	})
+
+	t.Run("memory_growth_pct_insufficient_data_returns_zero", func(t *testing.T) {
+		rssData := []float32{float32(100 * 1024 * 1024)}
+		rss := timeseries.NewWithData(0, 30, rssData)
+		limit := float32(512 * 1024 * 1024)
+		to := timeseries.Time(0)
+
+		pct := auditor.MemoryGrowthPct(rss, limit, to)
+		assert.Equal(t, float32(0), pct,
+			"MemoryGrowthPct should return 0 for insufficient data points (< 10)")
+	})
+
+	t.Run("memory_growth_pct_too_many_nans_returns_zero", func(t *testing.T) {
+		rssData := make([]float32, 120)
+		for i := range rssData {
+			if i%3 == 0 {
+				rssData[i] = float32(100*1024*1024 + i*1024*1024)
+			} else {
+				rssData[i] = timeseries.NaN
+			}
+		}
+		rss := timeseries.NewWithData(0, 30, rssData)
+		limit := float32(512 * 1024 * 1024)
+		to := timeseries.Time(119 * 30)
+
+		pct := auditor.MemoryGrowthPct(rss, limit, to)
+		assert.Equal(t, float32(0), pct,
+			"MemoryGrowthPct should return 0 when >20% of data points are NaN")
+	})
+
+	t.Run("memory_growth_pct_drop_resets_detection", func(t *testing.T) {
+		rssData := make([]float32, 120)
+		for i := 0; i < 60; i++ {
+			rssData[i] = float32(100*1024*1024 + i*2*1024*1024)
+		}
+		for i := 60; i < 120; i++ {
+			rssData[i] = float32(50*1024*1024 + (i-60)*1024*1024)
+		}
+		rss := timeseries.NewWithData(0, 30, rssData)
+		limit := float32(1024 * 1024 * 1024)
+		to := timeseries.Time(119 * 30)
+
+		pct := auditor.MemoryGrowthPct(rss, limit, to)
+		assert.Greater(t, pct, float32(0),
+			"MemoryGrowthPct should detect growth in the longest continuous segment after a drop")
+	})
+
+	t.Run("memory_growth_pct_empty_series_returns_zero", func(t *testing.T) {
+		rss := timeseries.New(0, 30, 30)
+		limit := float32(512 * 1024 * 1024)
+		to := timeseries.Time(29 * 30)
+
+		pct := auditor.MemoryGrowthPct(rss, limit, to)
+		assert.Equal(t, float32(0), pct,
+			"MemoryGrowthPct should return 0 for empty time series")
+	})
+
+	t.Run("rbac_permissions_gate_mcp_log_access", func(t *testing.T) {
+		viewerRole := rbac.Roles[2]
+		assert.Equal(t, rbac.RoleViewer, viewerRole.Name)
+
+		logAction := rbac.Actions.Project("proj1").Logs().View()
+		assert.True(t, viewerRole.Permissions.Allows(logAction),
+			"Viewer role should allow viewing logs via MCP")
+
+		editAction := rbac.Actions.Project("proj1").Integrations().Edit()
+		assert.False(t, viewerRole.Permissions.Allows(editAction),
+			"Viewer role should NOT allow editing integrations")
+	})
+
+	t.Run("rbac_admin_has_full_mcp_access", func(t *testing.T) {
+		adminRole := rbac.Roles[0]
+		assert.Equal(t, rbac.RoleAdmin, adminRole.Name)
+
+		allActions := rbac.Actions.List()
+		for _, action := range allActions {
+			assert.True(t, adminRole.Permissions.Allows(action),
+				"Admin should be allowed all actions, failed for scope=%s verb=%s", action.Scope, action.Action)
+		}
+	})
+
+	t.Run("rbac_editor_can_view_logs_but_not_edit_integrations", func(t *testing.T) {
+		editorRole := rbac.Roles[1]
+		assert.Equal(t, rbac.RoleEditor, editorRole.Name)
+
+		logAction := rbac.Actions.Project("proj1").Logs().View()
+		assert.True(t, editorRole.Permissions.Allows(logAction),
+			"Editor should be able to view logs")
+
+		integrationEditAction := rbac.Actions.Project("proj1").Integrations().Edit()
+		assert.False(t, editorRole.Permissions.Allows(integrationEditAction),
+			"Editor should NOT be able to edit integrations")
+	})
+
+	t.Run("rbac_permission_uses_glob_match_for_node_scopes", func(t *testing.T) {
+		ps := rbac.PermissionSet{
+			rbac.NewPermission(rbac.ScopeNode, rbac.ActionView, rbac.Object{"node_name": "worker-*"}),
+		}
+		assert.True(t, ps.Allows(rbac.Actions.Project("p1").Node("worker-01").View()),
+			"Permission with 'worker-*' should match 'worker-01'")
+		assert.False(t, ps.Allows(rbac.Actions.Project("p1").Node("master-01").View()),
+			"Permission with 'worker-*' should NOT match 'master-01'")
+	})
+
+	t.Run("deployment_status_links_to_memory_audit", func(t *testing.T) {
+		app := model.NewApplication(model.NewApplicationId("c1", "default", model.ApplicationKindDeployment, "svc"))
+		instance := app.GetOrCreateInstance("svc-pod-1", nil)
+		instance.Pod = &model.Pod{ReplicaSet: "svc-abc123"}
+		container := &model.Container{
+			Name:        "main",
+			MemoryRss:   timeseries.NewWithData(0, 30, makeMonotonicRSS(50, 150, 120)),
+			MemoryLimit: timeseries.NewWithData(0, 30, makeConstTS(256*1024*1024, 120)),
+		}
+		instance.Containers["main"] = container
+
+		now := timeseries.Now()
+		statuses := model.CalcApplicationDeploymentStatuses(app, model.CheckConfigs{}, now)
+
+		leakPct := auditor.MemoryGrowthPct(
+			container.MemoryRss,
+			float32(256*1024*1024),
+			timeseries.Time(119*30),
+		)
+
+		if len(statuses) > 0 {
+			assert.Greater(t, leakPct, float32(0),
+				"When deployments exist and memory grows, MemoryGrowthPct should be positive")
+		}
+	})
+}
